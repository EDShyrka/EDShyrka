<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:EDShyrka.UI"
             xmlns:vm="clr-namespace:EDShyrka.UI.ViewModels"
             xmlns:cc="clr-namespace:EDShyrka.UI.CustomControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EDShyrka.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             DataContext="{vm:ViewModelProvider vm:MainViewModel}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="9*" />
    </Grid.RowDefinitions>

    <cc:AnimatedShyrka Grid.Row="0"
        HorizontalAlignment="Left" VerticalAlignment="Top" />

  </Grid>
</UserControl>
