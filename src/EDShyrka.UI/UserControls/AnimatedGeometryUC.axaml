<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uc="clr-namespace:UserControls"
             mc:Ignorable="d" d:DesignWidth="80" d:DesignHeight="64"
             x:Class="UserControls.AnimatedGeometryUC">
  <uc:AnimatedGeometryUC.Resources>
    <SolidColorBrush x:Key="Brush01" Color="Red" />
    <SolidColorBrush x:Key="Brush02" Color="Green" />
    <SolidColorBrush x:Key="Brush03" Color="Blue" />
  </uc:AnimatedGeometryUC.Resources>
  
  <Image Stretch="Uniform">
    <Image.Source>
      <DrawingImage>
        <DrawingGroup>
          <GeometryDrawing Brush="{StaticResource Brush01}"
                           Geometry="M80,54 A4,4 0 0 0 88,54 A4,4 0 0 0 80,54" />
          <GeometryDrawing Brush="{StaticResource Brush02}"
                           Geometry="M09,28 A5,5 0 0 0 19,28 A5,5 0 0 0 09,28" />
          <GeometryDrawing Brush="{StaticResource Brush03}"
                           Geometry="M56,04 A7,7 0 0 0 70,04 A7,7 0 0 0 56,04" />
        </DrawingGroup>
      </DrawingImage>
    </Image.Source>
  </Image>
</UserControl>
